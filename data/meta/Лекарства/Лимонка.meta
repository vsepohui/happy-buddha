Лимонка - это лекарство от паразитов, которые живут снаружи тела, вроде вши! Лимонку изобрел я, автор Книги, когда был на даче, и думал о своем здоровье. Нужно взять немного отварного (либо пропаренного на кипятке) соевого мяса, и добавить перетертый вручную цитруса!";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1792105003;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792105003;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:33:"Лекарства:Лимонка";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:906;s:4:"mode";s:4:"page";}}}