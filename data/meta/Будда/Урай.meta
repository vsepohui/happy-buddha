Урай - это Чудо Света от Будды Гаутамы. Урай - это центр мира. Это город на 44 тысячи населения по плану Будды. В нем должны быть: 1) Башня Дозора 2) Линия Связи 3) Автодорога 4) Аэродром для “птичьего транспорта” 5) Рядом - дорога на “большую землю”, хоть по “тягловому транспорту”, но не в нем самом, чтобы бандит не приехал просто 6) Не должно быть зоны и места лишения свободы (это не выполнятеся уже 60 лет из-за психиатрии, КПЗ и ИВС) 7) Точки сбыта лекарств и продуктов (с этим - туго, п…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1792100681;s:8:"modified";i:1792100722;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792100722;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:19:"Будда:Урай";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:1643;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:7:"trunaev";s:12:"Ivan Trunaev";}}}