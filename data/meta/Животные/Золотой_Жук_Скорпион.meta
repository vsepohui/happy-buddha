Если вы покушали куриных яичек, то не спешите выкидывать скорлупу - попробуйте закопать ее в домашний горшочек с растением, и тогда уже через сутки могут вылупиться Золотые Жуки, либо если вы очень сильный мужчина, рожденный в хороший день - то Скорпион! Они будут хранителями вашего очага, и защищать от грабителей! Если горшочка нет - то просто закопайте скорлупу в саду, и тогда потом в этой жизни, вам могут подарить домашнее растение, даже кактус, если повезет!…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1792095999;s:8:"modified";i:1792097847;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792097847;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"E";s:2:"id";s:55:"Животные:Золотой_Жук_Скорпион";s:4:"user";s:7:"trunaev";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:1245;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:7:"trunaev";s:12:"Ivan Trunaev";}}}