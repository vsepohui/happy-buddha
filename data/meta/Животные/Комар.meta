Будда Хотэй очень расстроился из-за того, что в Государстве, где жили его соседи - Русские, очень много промышленных отходов, их даже специально производили на заводы, чтобы создать рабочие места. И Будда сделал так, чтобы из мусора появлялись Комары - умные насекомые, которые пьют кровь у тех, кто создает мусор!…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}s:11:"contributor";a:1:{s:7:"trunaev";s:12:"Ivan Trunaev";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1792099680;s:8:"modified";i:1792099692;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792099692;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"E";s:2:"id";s:27:"Животные:Комар";s:4:"user";s:7:"trunaev";s:3:"sum";s:0:"";s:5:"extra";s:0:"";s:10:"sizechange";i:3;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:7:"trunaev";s:12:"Ivan Trunaev";}}}