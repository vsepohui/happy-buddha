Реки - это Чудеса Будды, который тот открывал своей Магической Силой! Они открывались либо в непосредственном контакте Будды с грунтом, либо с Передачей Силы на Открытие другим смертным. Не все реки открыты в нужных местах, это было ошибкой тех, кому Будда передавал Силу, но их задача - исправить это “недоразумение” (в мягком смысле, на самом деле, ошибка, зачастую, была - роковой!).…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:5:{s:4:"date";a:2:{s:7:"created";i:1792096965;s:8:"modified";i:1792100520;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792100520;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:23:"Природа:Река";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:1549;s:4:"mode";s:4:"page";}s:11:"contributor";a:1:{s:7:"trunaev";s:12:"Ivan Trunaev";}}}