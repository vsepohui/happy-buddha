У меня, автора Книги, в доме растет Алоэ, у него порой отламывают лепестки из-за моей халатности, и сегодня это растение обратило мое внимание на лепесток: “Сделай с ним что-нибудь!”. Я сел в медитацию, и увидел свой СМЕРТЬ: всю в волдырях на легких из-за парой вейпов которые все нажигают, и которые я три раза курил по своей неосторожности. Смерть указала мне на желуди, которые лежали у меня в комнате, на листик табака, которые я проращиваю, и на алоэ, и показала, как соединить эти три ча…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1792104969;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792104969;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:27:"Растения:Алтай";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:1937;s:4:"mode";s:4:"page";}}}