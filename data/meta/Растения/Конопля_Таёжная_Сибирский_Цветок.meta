Конопля Таёжная, или Сибирский Цветок - это смесь Веселого Мха, и Хвойных Деревьев из Сибири. Это растение - аналог Конопли Рудералис, но только не автоцвет, которых цветет в горах, а потом - засыхает, а как Секвойя - многолетнее дерево, которое дает побеги до 7 раз за сезон, если на Юге Сибири, а на Севере - может дать побег 2-4 раза!…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1792106348;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792106348;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:78:"Растения:Конопля_Таёжная_Сибирский_Цветок";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:884;s:4:"mode";s:4:"page";}}}