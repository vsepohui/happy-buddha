Куст Кет - это смесь Березы, или Манго и Табака! Куст Кет не совсем для людей, он в первую очередь для Кошачьих - рысей, тигров, львов, барсов, котов. Он помогает им “строить отношения с миром”! Если кошка потерялась в окружающий реальности, то куст обучит ее, как вернуться, если она погрызет листьев, а потом - ляжет спать!…";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:8:"relation";a:1:{s:10:"firstimage";s:0:"";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1792106895;}s:7:"creator";s:12:"Ivan Trunaev";s:4:"user";s:7:"trunaev";s:11:"last_change";a:9:{s:4:"date";i:1792106895;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:23:"Растения:Кет";s:4:"user";s:7:"trunaev";s:3:"sum";s:14:"создано";s:5:"extra";s:0:"";s:10:"sizechange";i:845;s:4:"mode";s:4:"page";}}}