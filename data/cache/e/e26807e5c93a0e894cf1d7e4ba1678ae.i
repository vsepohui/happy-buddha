a:14:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:17:"Кока-кола";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:322:"Напиток Кока-кола придумал Господин Джон Леннон, когда ему было 17 лет, до этого Кока-колой называли бычью кровь с паразитами, с добавлением психостимуляторов, вроде амфетамина!";}i:2;i:34;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:356;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:356;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:232:"Чтобы приготовить Кока-колу, нужно взять Березовый сок, добавить порошок Масала-чай, Ежовник Гребенчатый, или можно еще сахару!";}i:2;i:358;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:590;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:590;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:201:"Кока-кола богата так называемыми “тауринами”, то есть хорошо бодрит, но еще она - одно из лучших глистогонных!";}i:2;i:592;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:793;}i:12;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:794;}i:13;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:794;}}