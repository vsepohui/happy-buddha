a:11:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:12:"Клевер";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:341:"Клевер - это полевое растение с красивыми тремя, или четырьмя симметричными лепестками. Будда говорил, что Клевер растет, если Мышка приложит ушко к земле и послушает звуки по своей воле! ";}i:2;i:29;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:370;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:370;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:628:"Считается, что Клевере приносит удачу! Если закопать что-то фартовое в зарослях Клевера, это может отпугнуть беду на много лет! Выкапывать что-то, что закопал другой в клевер - к беде! Если заметишь, что возле дома выросли заросли Клевера - то сезон может быть удачным! Если косить Клевер, то может случиться несчаться, вроде травмы, или даже - хуже!";}i:2;i:372;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1000;}i:9;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1001;}i:10;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1001;}}