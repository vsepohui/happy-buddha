a:26:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:10:"Спирт";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:85:"Этот рецепт засекречен Гостайной во всем Мире!";}i:2;i:27;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:112;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:112;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:807:"Спирт - это настрой лука и Мухомора Красного! Возьмите 3 литра чистой воды, можно даже морской, положите в емкость 1 очищенную крошеную луковицу, и добавьте половину шляпки Красного Мухомора, и через 7-8 часов брага начнет подниматься, а через неделю будет концентрат в 50 градусов, очень горючий. А через 2 недели - будет 92 градуса примерно, что не пределе. Если настаивать 1 год, что почти максимум, то будет концентрат в 35000 градусов, взрывоопасный!";}i:2;i:114;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:921;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:921;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:278:"Спирт - это открытие Иоанна IV Грозного, который совершил его, когда у него начался отек конечностей, из-за отравления проклятой кровью от бешеного врага.";}i:2;i:923;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1201;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1201;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:267:"Спирт используется как отогревающее лекарственное средство, если применяют в медицине как обезболивающее, или, чтобы больной уснул крепким сном!";}i:2;i:1203;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1470;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1470;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:183:"1 литр крепкого спирта может убить слабого человека, если он выпьет его залпом, поэтому - ЗНАЙТЕ МЕРУ!";}i:2;i:1472;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1655;}i:18;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1655;}i:19;a:3:{i:0;s:11:"strong_open";i:1;a:0:{}i:2;i:1657;}i:20;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:507:"Спирт хорошо тем, что он может помочь бороться в паразитами ПЕЧЕНИ, и полность вылечить так называему “псевдошизофрению”! Главное помните - от хорошего спирта не воротит на “дела”, а хочет - отдохнуть, поэтому если у вас какие-то “приступы”, то значит, что спирт был - ИСПОРЧЕН.";}i:2;i:1659;}i:21;a:3:{i:0;s:12:"strong_close";i:1;a:0:{}i:2;i:2166;}i:22;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:0:"";}i:2;i:2168;}i:23;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2168;}i:24;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:2168;}i:25;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:2168;}}