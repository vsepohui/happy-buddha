a:33:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:22:"Телевидение";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:124:"Телевидение показывать меня со стороны в оптимальном виде для всех ";}i:2;i:39;}i:5;a:3:{i:0;s:18:"doublequoteopening";i:1;a:0:{}i:2;i:163;}i:6;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:18:"одинаково";}i:2;i:164;}i:7;a:3:{i:0;s:18:"doublequoteclosing";i:1;a:0:{}i:2;i:182;}i:8;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:255:", но нужна аналоговая Антенна, либо цифровой Декодер, если идет передача от Электросети! Еще - нужна Тарелка: для отвода глаз от моего жилища!";}i:2;i:183;}i:9;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:438;}i:10;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:438;}i:11;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:189:"Телевидение - это Чудо Будды Хотэя, которое он изобрел в 16 лет, после изобретения ЭВМ, и Волевого Экрана. ";}i:2;i:440;}i:12;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:629;}i:13;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:629;}i:14;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:324:"Телевидение показывает и передает то, что видит перед собой Шри Будда, кроме его снов и видений, а звук передает - то что говорит слышит ушами, но не думает, или воспринимает умом. ";}i:2;i:631;}i:15;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:955;}i:16;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:955;}i:17;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:331:"Телевидение передает на все Волевые Экраны с ЭВМ, а включает путем команды нажатия пальцем на правый верхний угол, и сдвига по диагонали вниз-влево немного, а выключается - наоборот.";}i:2;i:957;}i:18;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1288;}i:19;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1288;}i:20;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:366:"Телевидение можно только смотреть, но вне влиять на него как-то, через ЭВМ. Если Будда работает за компьютером, то на Телевидение - передается 100% такой же поток картинки и звуков, но с его комментариями.";}i:2;i:1290;}i:21;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1656;}i:22;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1656;}i:23;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:180:"Когда Шри Будда спит - его глаза прикрыты, и ум отдыхает, и Телевидение показывает “Черный Экран!”.";}i:2;i:1658;}i:24;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1838;}i:25;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1838;}i:26;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:237:"Уточнение: для Телевидения нужен рабочий Волевой Экран, подключенный к ЭВМ. ЭВМ нужен для вывода звукового потока на колонку в mono!";}i:2;i:1840;}i:27;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2077;}i:28;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:2077;}i:29;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:314:"По Телевидения не показываться личные данные с Волевого Экрана Будды: пароли доступа к сервисам, и части гениталий, если я на них смотрю. любовное соитие, если такое бывает!";}i:2;i:2079;}i:30;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:2393;}i:31;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:2394;}i:32;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:2394;}}