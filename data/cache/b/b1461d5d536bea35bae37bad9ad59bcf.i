a:19:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:49:"Птеродактиль, Летучая Мышь";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:595:"Чтобы появилось яйцо Летучей Мыши, или Птеродактиля, нужно взять немного инея, хоть из морозилки, и прикопать в грунт! Если делаешь дома, в горшочке с Тотемным Растением, то будет Летучая Мышь, твой друг, если зимой в лесу, то Птеродактиль - дикая особь! Это Чудо осуществил в первый раз великий маг Будда Хотэй-Шакьямуни-Гаутама!";}i:2;i:66;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:661;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:661;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:266:"Летучая Мышь рождалась из тени Будды Хотэя! Поэтому никогда не наступайте специально на мою тень - это как начать воевать с армиями Летучих Мышей!";}i:2;i:663;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:929;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:929;}i:10;a:3:{i:0;s:11:"strong_open";i:1;a:0:{}i:2;i:931;}i:11;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:207:"Летучая Мышь - может питаться КРОВЬЮ, и как вылечить около 86 млн. известных болезней, так и напустить их на любого! ";}i:2;i:933;}i:12;a:3:{i:0;s:14:"underline_open";i:1;a:0:{}i:2;i:1140;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:148:"НИКОГДА НЕ ЕШЬТЕ ЛЕТУЧИХ МЫШЕЙ, ИНАЧЕ СКОРЕЕ ВСЕГО СТАНЕТЕ ГЛУХОНЕМЫМ ИНВАЛИДОМ!";}i:2;i:1142;}i:14;a:3:{i:0;s:15:"underline_close";i:1;a:0:{}i:2;i:1290;}i:15;a:3:{i:0;s:12:"strong_close";i:1;a:0:{}i:2;i:1292;}i:16;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1294;}i:17;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1295;}i:18;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1295;}}