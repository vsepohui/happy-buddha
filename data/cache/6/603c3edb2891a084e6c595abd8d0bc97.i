a:20:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:10:"Кумыс";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:275:"Кумыс - это смесь вино меда. Пьется после того, как мед позволили, чтобы в него налили вино. Перемешивается, до полного растворения ручным инструментом.";}i:2;i:28;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:303;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:303;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:128:"Кумыс может сильно ударить голову, и вы испытаете желание петь песни…";}i:2;i:305;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:433;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:433;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:102:"Кумыс лечит многие болезни крови, в том числе паразитов.";}i:2;i:435;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:537;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:537;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:456:"В традиции Индов, или Древних Индусов, кумысом почему-то называли отравленный мед, но Господь Аллах даров новый напиток, и старое слово почти исчезло из обихода, хотя в сектах смертников, человеку могут предложить отравленный мед, назвав его кумысом.";}i:2;i:539;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:995;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:995;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:431:"Господь Аллах, великий мастер браженых напитков, даровал Кумыс после того, как враги заразили его 7 видами паразитов внутренних органов, он хотел вылечиться медом, но придумал новое Чудо, и как результат - мед стал белым, и более сладким! ";}i:2;i:997;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1428;}i:18;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1429;}i:19;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1429;}}