a:11:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:12:"Ананас";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:743:"Господь Аллах придумал Ананас на свой День Рождения, то есть был просто день, когда он отмечал 20-летие своего Пробуждения! К Господу пришли русские, и попросили сотворить Чудо, чтобы Князья порадовались, или ему не отдадут Кавказ в пользование! Господь Аллах подумал, и у него родилось решение: нужно посадить в саду, даже хоть на кладбище, семена Апельсина, Киви и Мандарина, и вырастет Чудное Растение ЖИЗНИ!";}i:2;i:29;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:772;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:772;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:278:"Для справки: до Аллаха, ананасом называли голову смертника, воткнутую на кол перед ловушкой в яме, куда падал тот, кто шел снять голову, чтобы захоронить!";}i:2;i:774;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1052;}i:9;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1053;}i:10;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1053;}}