a:20:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:14:"Крапива";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:13:"internalmedia";i:1;a:7:{i:0;s:29:":Растения:krapiwa.jpg";i:1;s:0:"";i:2;N;i:3;s:3:"400";i:4;N;i:5;s:5:"cache";i:6;s:7:"details";}i:2;i:31;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:69;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:69;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:173:"Крапива появляется на свет, если Будда трет спину еловыми ветками из кусочков отлетающей кожи.";}i:2;i:71;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:244;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:244;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:1230:"Крапива полезна для массажа, потому что с ожогами фитонцидами (а это первое растение с фитонцидами, которое выросло на глазах в Будды во взрослое растение) стимулирует ток крови, и обмен нейронов в синапс-тринапсных группах нервных связей. Массаж крапивой может вылечить неврастению, сложные заболевания нервной системы, помочь победить паразитов нервов! Если у вас диагноз, вроде “латентная шизофрения”, или “шизофазия”, то по Буддийским Трактатам - нужно в первую очередь попробовать массаж из свежих веток Крапивы, но делать его нужно самому себе, и выбирать места по желанию - кто-то начинает с рук, кто-то с волос и темечка, кто-то массирует глаза или гениталии… и т.д.";}i:2;i:246;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1476;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1476;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:69:"Крапиву можно считать источником ТГК!";}i:2;i:1478;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1547;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1547;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:157:"Поскольку Крапива - родственник Каннабиса, то она может иметь с ним смежное потомство!";}i:2;i:1549;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1706;}i:18;a:3:{i:0;s:13:"section_cl