a:8:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:14:"Ежевика";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:1146:"Царю Иоанну IV Грозному предложили для проверки на Царя придумать новую ягоду, но съедобную и сладкую, тогда он сообщил после медитации, где он увидел Смерть, которая указала на руку в занозах, а потом показала ягодник и банку с вареньями, и Царь сделал так: вытащил занозы, которые мазал мазями и пчелиного яда, некоторые были в крови, и те, что были в крови - посадил в грунт! И выросли: шиповник с розами, очень красивыми, ежевика, которая привлекала ежей, и малина, союзник медведей! Все ягодники, к сожалению, с 2022 года находятся в закрытых террариумах МГУ, из-за чего Университет перестал работать, как и все образование на Планете!";}i:2;i:31;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1177;}i:6;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1178;}i:7;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1178;}}