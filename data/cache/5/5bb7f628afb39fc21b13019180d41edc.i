a:20:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:8:"Храм";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:39:"Храм - это дом Монаха. ";}i:2;i:25;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:64;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:64;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:353:"Чтобы построить Храм, Монах должен обжиться, то есть прожить в одном месте из отъездов (кроме вынужденных), 4 года, или более, и совершаться в нем религиозные практики в основное свободное время. ";}i:2;i:66;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:419;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:419;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:200:"Далее, Монах должен СВОЕЙ РУКОЮ (дланью) прочертить (отрисовать) изображения Господа, и повесить его на стену! ";}i:2;i:421;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:621;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:621;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:578:"Возможны варианты: скульптура, мозаика, идол из дерева или камня, наглядная кукла, модель из конструктора, если она красивая - любой способ художественного выражения, даже распечатанная, сделанная на компьютере иллюстрация, в общем - возможен любой визуальный жанр, в котором Монах может превосходно работать руками!";}i:2;i:623;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1201;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1201;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:169:"Возможна - даже репродукция старой Иконы от Господа, если Монах выполнил работу ПРЕВОСХОДНО!";}i:2;i:1203;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1372;}i:18;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1373;}i:19;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1373;}}