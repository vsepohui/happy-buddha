a:8:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:16:"Апельсин";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:1146:"Апельсин - это слава всей Азии. Он появился благодаря открытию Господа Аллаха, когда у того, и его армии начала цинга от отравления фосфором на войне! Аллах сел в медитации у камня, который ему воздвигли, и увидел свою смерть - что он станет весь красно-фиолетовый, как маринованный в фосфоре перец, которые его накормили враги, потом он увидел корову, которая давала молоко теленку, и Смерть плюнула цыкая. Тогда Аллах засмеялся, и совершил открытие: от сплюнул в молоко которое ему принесли, и прикопал в земле, а потом выросло Апельсиновое Древо. С тех пор проверка на Аллаха у Арабов, это плевок в молоко, чтобы получился АПЕЛЬСИН!";}i:2;i:32;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1178;}i:6;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1179;}i:7;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1179;}}