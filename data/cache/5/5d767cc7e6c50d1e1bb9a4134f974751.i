a:20:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:16:"Апельсин";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:56:"Апельсин - это слава всей Азии. ";}i:2;i:32;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:88;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:88;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:216:"Он появился благодаря открытию Господа Аллаха, когда у того, и его армии начала цинга от отравления фосфором на войне! ";}i:2;i:90;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:306;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:306;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:464:"Аллах сел в медитации у камня, который ему воздвигли, и увидел свою смерть - что он станет весь красно-фиолетовый, как маринованный в фосфоре перец, которые его накормили враги, потом он увидел корову, которая давала молоко теленку, и Смерть плюнула цыкая. ";}i:2;i:308;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:772;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:772;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:257:"Тогда Аллах засмеялся, и совершил открытие: от сплюнул в молоко которое ему принесли, и прикопал в земле, а потом выросло Апельсиновое Древо. ";}i:2;i:774;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1031;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1031;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:153:"С тех пор проверка на Аллаха у Арабов, это плевок в молоко, чтобы получился АПЕЛЬСИН!";}i:2;i:1033;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1186;}i:18;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1187;}i:19;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1187;}}