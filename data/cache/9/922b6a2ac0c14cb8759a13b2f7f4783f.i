a:28:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:42:"Тотемное Растение Дома";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:227:"Если у вас дома в горшке живет растение, ваш друг, и вы за ним ухаживаете, то вы можете сделать из него Тотемное Растение Дома!";}i:2;i:59;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:286;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:286;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:284:"Для этого, возьмите немного ткани от одежды, которую вы носили, которую вы любили, пропитайте ее в глине для лепки, и сделайте “одежду” для ствола растения!";}i:2;i:288;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:572;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:572;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:170:"Никогда не воруйте Тотемные Растения, инача вашу квартиру, скорее всего, ограбят добрые люди!";}i:2;i:574;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:744;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:744;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:301:"Тотемные Растения - это идея Будду Хотэя: он жил в замке, и у него был маленький росток, и он придумал, как сделать так, чтобы он гордился своей сутью - быть частью Мира!";}i:2;i:746;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1047;}i:15;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1047;}i:16;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:208:"Тотемные Растения оберегают жилище, предупреждают об опасности, а еще - он лучше всех цветут и растут в вашем доме!";}i:2;i:1049;}i:17;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1257;}i:18;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1257;}i:19;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:281:"Что важно: для Тотемного Растения нужна чаша с запасом, то есть, например, для тюльпана - нужно около 2-3 литров, а для каннабиса - 20-30 литров на одно растение!";}i:2;i:1259;}i:20;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1540;}i:21;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1540;}i:22;a:3:{i:0;s:11:"strong_open";i:1;a:0:{}i:2;i:1542;}i:23;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:247:"Тотемное Растение Дома хорошо тем, что держит дом в порядке, и помогает накоплению силы жильца в доме, если вы понимаете о чем идет речь!";}i:2;i:1544;}i:24;a:3:{i:0;s:12:"strong_close";i:1;a:0:{}i:2;i:1791;}i:25;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1793;}i:26;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1794;}i:27;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1794;}}