a:13:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:14:"Верблюд";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:151:"Чтобы зародился Верблюд, нужно, что плевок Будды оказался в сухой пустыне на песке!";}i:2;i:31;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:182;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:182;}i:7;a:3:{i:0;s:11:"strong_open";i:1;a:0:{}i:2;i:184;}i:8;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:1045:"Верблюды - превосходные провожатые: они обожают хороших людей, и помогают им проложить  марсшрут, если их хоть чуть-чуть покормить рисовой кашей с медом, или изюмом! Верблюд может вывести заблудившегося путника к Оазису - тайному месту с родниками и пальмами, если тот попросит помочь, и пообещает никого не вести следом. Сами эти Оазисы - это места где Будда, Кришна или Аллах ночевали в пустынях - там хорошие фрукты, и чистая вода, если не боишься пить с земли из лужи после Верблюда (а ему вы обязаны будете уступать, иначе он - может откусить голову, или руку и ногу на выбор)!";}i:2;i:186;}i:9;a:3:{i:0;s:12:"strong_close";i:1;a:0:{}i:2;i:1231;}i:10;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1233;}i:11;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1234;}i:12;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1234;}}