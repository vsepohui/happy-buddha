a:8:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:29:"Цветущие Поляны";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:1085:"Цветущие Поляны - это Чудо, результат от любви Солнца: оно направляет свои Лучи на любимые места, где больше всего наслаждался природой Бог, и там - расцветают Растения, и очень тепло, бьют ручьи, если нужно, плодится зверь - Торжество Жизни из-за любви Солнца! Если в этом месте Рупана, то - творятся Чудеса, вроде ростка камней, восстановления предметов, или исцеления болезней у немощных! Если там Темпл - то он нагревается от Любви, и в нем происходит Мироток, то есть - объединение знания присутствующих, со знанием Господа! А сам Темпл - может расти, и улучшаться! А алчущим - хочется покинуть Темпл!";}i:2;i:46;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1131;}i:6;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1132;}i:7;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1132;}}