a:17:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:17:"Живой Чай";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:343:"Живой Чай - это результат отношений Чайного Дерева, и Воды! Он может появиться даже в чашке Чай, после заваривания, если дать настояться, если в Чае - были споры, и они реши смешаться с водой! ";}i:2;i:34;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:377;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:377;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:175:"Живой Чай - живет в Болотах, Озерах, Прудах, либо - на дне водоемов, может жить - даже на дне Океана!";}i:2;i:379;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:554;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:554;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:119:"Живой Чай живет в желчном пузыре, и помогает синтезу аминокислот!";}i:2;i:556;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:675;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:675;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:284:"Чтобы Живой Чай простоялся, нужно чтобы прошло минимум 2-3 недели, но лучше в районе полугода. Чайные Напитки вроде Нести хороши в этом плане, если выдержаны.";}i:2;i:677;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:961;}i:15;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:962;}i:16;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:962;}}