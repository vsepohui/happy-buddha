a:17:{i:0;a:3:{i:0;s:14:"document_start";i:1;a:0:{}i:2;i:0;}i:1;a:3:{i:0;s:6:"header";i:1;a:3:{i:0;s:17:"Бурый Лев";i:1;i:1;i:2;i:1;}i:2;i:1;}i:2;a:3:{i:0;s:12:"section_open";i:1;a:1:{i:0;i:1;}i:2;i:1;}i:3;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:1;}i:4;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:379:"Бурый Лев - это потомок от любви Сибирского Медведя и Дикого Кота! Очень опасный лесной житель Сибири, любит морковь и корни растений. Может перепрыгнуть с места автодорогу в 6-7 полос, если на ней нет движения!";}i:2;i:34;}i:5;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:413;}i:6;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:413;}i:7;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:328:"Может жить по 600 лет, и вырасти до массы в 302 кг, и высоту в 1.5 метра спины. Может встать на задние лапы, и опрокинуть столб освещения на автодороге, если есть опасность, и устроить ДТП!";}i:2;i:415;}i:8;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:743;}i:9;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:743;}i:10;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:246:"Лучше на таких не охотиться, потому что кровь от туши навсегда отвадит от вас домашних кошек - они будут нападать, и съедать браконьера!";}i:2;i:745;}i:11;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:991;}i:12;a:3:{i:0;s:6:"p_open";i:1;a:0:{}i:2;i:991;}i:13;a:3:{i:0;s:5:"cdata";i:1;a:1:{i:0;s:107:"Они очень умные, их рев может спровоцировать ГРОМ и МОЛНИИ!";}i:2;i:993;}i:14;a:3:{i:0;s:7:"p_close";i:1;a:0:{}i:2;i:1100;}i:15;a:3:{i:0;s:13:"section_close";i:1;a:0:{}i:2;i:1101;}i:16;a:3:{i:0;s:12:"document_end";i:1;a:0:{}i:2;i:1101;}}